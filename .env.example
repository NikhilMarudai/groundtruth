# Neo4j Aura (user provisions; cloud-reachable so RocketRide/Butterbase can hit it)
NEO4J_URI=neo4j+s://xxxx.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=
# Neo4j HTTP Query API (for Butterbase function -> graph, no driver needed)
NEO4J_HTTP_URL=https://xxxx.databases.neo4j.io/db/neo4j/query/v2
# LLM + embeddings + search (build-time curation + runtime synthesis)
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=
TAVILY_API_KEY=
# RocketRide recommendation endpoint (filled after pipeline deploy)
RR_RECOMMEND_URL=
# Butterbase (app created via MCP)
BUTTERBASE_APP_ID=
BUTTERBASE_SERVICE_KEY=
# Bonuses
DAYTONA_API_KEY=
